# Copy file ini ke .env.local untuk local development
# Dan set ke environment variables di Vercel Project Settings

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth2callback
# Untuk production di Vercel gunakan:
# GOOGLE_REDIRECT_URI=https://sirkaloka.vercel.app/api/oauth2callback
SECRET_KEY=generate-strong-random-secret
